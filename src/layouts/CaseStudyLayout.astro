---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  status: string;
  pitch: string;
  /** slug → label for the next-case rotator at the bottom */
  nextSlug: string;
  nextTitle: string;
}
const { title, description, category, status, pitch, nextSlug, nextTitle } = Astro.props;
---

<BaseLayout title={`${title} | Aditya Varma`} description={description}>
  <Header />

  <article class="pt-12 md:pt-20 pb-24">
    <header class="container-x animate-on-scroll">
      <p class="text-xs uppercase tracking-[0.3em] text-accent mb-3">{category} · {status}</p>
      <h1 class="font-display text-4xl md:text-6xl text-white tracking-wide leading-tight">
        {title}
      </h1>
      <p class="mt-5 text-lg md:text-xl text-fog/90 max-w-3xl leading-relaxed">{pitch}</p>
    </header>

    <div class="container-x mt-14 max-w-3xl mx-auto case-content">
      <slot />
    </div>
  </article>

  <!-- Next case rotator -->
  <section class="border-t border-white/5 bg-ink-950 py-16">
    <div class="container-x flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-fog-muted mb-2">Next case</p>
        <a href={`/work/${nextSlug}`} class="font-display text-2xl md:text-3xl text-white hover:text-accent transition-colors">
          {nextTitle} →
        </a>
      </div>
      <a href="/#work" class="text-sm text-fog-muted hover:text-white transition-colors">All work ↑</a>
    </div>
  </section>

  <Footer />
</BaseLayout>
